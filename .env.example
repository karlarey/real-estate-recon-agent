# ── Chat assistant (local Llama via Ollama) ──────────────────────────
# The assistant talks to a local Ollama server over plain HTTP -- no SDK, no
# API key, no data leaving the machine.
#
# Nothing here is required. With no Ollama running, the Assistant tab says so
# and every other feature works unchanged.

OLLAMA_URL=http://127.0.0.1:11434

# Which model to use. Pull it first:  ollama pull llama3.1:8b
# 8B wants ~8GB RAM free. On a smaller machine use llama3.2:3b.
OLLAMA_MODEL=llama3.1:8b

# Seconds to wait for one model response.
OLLAMA_TIMEOUT=120

# ── Review advisor enrichment (optional, unused by default) ──────────
# The rules advisor works with no key. Setting GOOGLE_API_KEY enables an
# optional Gemini rewrite of its rationale; any failure falls back to the
# rules text. Not required for the demo.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
